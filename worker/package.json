{
  "name": "uptimeworker",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "cf:build": "node ../scripts/set-wrangler-d1-id.mjs \"$UPTIMEFLARE_D1_DATABASE_ID\" && npm run typecheck",
    "cf:deploy:built": "wrangler d1 migrations apply uptimeflare_state --remote --config wrangler.toml && wrangler deploy --config wrangler.toml",
    "cf:deploy": "npm run cf:deploy:built",
    "start:dev": "wrangler dev --config wrangler-dev.toml --test-scheduled --persist-to ../.wrangler/state",
    "deps:install": "npm install --verbose --no-fund --no-audit",
    "deps:ci": "npm ci --verbose --no-fund --no-audit",
    "deps:update": "npm-check-updates -u && npm run deps:install",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^26",
    "npm-check-updates": "^23.1.1",
    "wrangler": "^4.166.0",
    "typescript": "^7.0.2"
  }
}
