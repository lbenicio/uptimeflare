{
  "name": "uptimeflare",
  "version": "0.1.1",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "start:dev": "next dev",
    "start:prod": "next start",
    "start:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:pkg": "next build",
    "fmt:lint": "eslint --fix .",
    "fmt:format": "prettier --write .",
    "deps:install": "npm install --verbose --no-fund --no-audit",
    "deps:ci": "npm ci --verbose --no-fund --no-audit",
    "deps:update": "npm-check-updates -u && npm run deps:install",
    "cf:build": "node scripts/set-wrangler-d1-id.mjs && opennextjs-cloudflare build",
    "cf:deploy:built": "opennextjs-cloudflare deploy",
    "cf:deploy": "npm run cf:deploy:built",
    "cf:upload": "node scripts/set-wrangler-d1-id.mjs && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "test:unit": "node --experimental-strip-types --experimental-loader=./test/ts-extension-loader.mjs --experimental-test-module-mocks --experimental-test-coverage --test --test-coverage-include=worker/src/monitor.ts --test-coverage-include=worker/src/util.ts --test-coverage-include=lib/monitor-state.ts --test-coverage-include=lib/d1-write-retry.ts --test-coverage-include=util/color.ts --test-coverage-lines=98 --test-coverage-functions=98 --test-coverage-branches=98 test/unit/*.test.mjs",
    "coverage:unit": "c8 --all --extension .ts --include worker/src/monitor.ts --include worker/src/util.ts --include lib/monitor-state.ts --include lib/d1-write-retry.ts --include util/color.ts --reporter=lcov --reporter=text --reports-dir=coverage npm run test:unit",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "build": "npm run build:pkg",
    "start": "npm run start:prod"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.0",
    "@tabler/icons-react": "^3.52.0",
    "@types/moment-precise-range-plugin": "^1.3.0",
    "chart.js": "^4.6.1",
    "chartjs-adapter-moment": "^1.0.1",
    "moment": "^2.31.0",
    "moment-precise-range-plugin": "^1.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch@^10.2.2": "^11.0.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "c8": "^12.0.0",
    "eslint": "^10",
    "eslint-config-next": "^16.4.6",
    "eslint-plugin-perfectionist": "^5.14.0",
    "npm-check-updates": "^23.1.1",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.166.0"
  }
}
