{
  "name": "uptimeflare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "vercel-build": "next build",
    "start:dev": "next dev",
    "start:preview": "npm run preview",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "configure:d1": "node scripts/set-wrangler-d1-id.mjs \"$UPTIMEFLARE_D1_DATABASE_ID\"",
    "deploy:cf": "npm run configure:d1 && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cf": "npm run configure:d1 && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "build:pkg": "next build",
    "start:prod": "next start",
    "fmt:lint": "next lint",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deps:install": "npm install --verbose --no-fund --no-audit",
    "deps:ci": "npm ci --verbose --no-fund --no-audit",
    "deps:update": "npm-check-updates -u && npm run deps:install",
    "deploy": "npm run configure:d1 && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "npm run configure:d1 && opennextjs-cloudflare build && opennextjs-cloudflare upload"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "@mantine/core": "^9.8.0",
    "@mantine/hooks": "^9.8.0",
    "@tabler/icons-react": "^3.52.0",
    "@types/moment-precise-range-plugin": "^1.3.0",
    "chart.js": "^4.6.1",
    "chartjs-adapter-moment": "^1.0.1",
    "moment": "^2.31.0",
    "moment-precise-range-plugin": "^1.3.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1"
  },
  "overrides": {
    "glob": "^14.0.6",
    "minimatch@^10.2.2": "^11.0.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "^16.4.6",
    "npm-check-updates": "^23.1.1",
    "postcss": "^8.5.33",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.162.0"
  }
}
