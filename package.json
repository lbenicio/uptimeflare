{
  "name": "uptimeflare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "vercel-build": "next build",
    "build": "next build",
    "start:dev": "next dev",
    "start:preview": "npm run preview",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:cf": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "build:pkg": "next build",
    "start:prod": "next start",
    "fmt:lint": "next lint",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "deps:install": "npm install --verbose --no-fund --no-audit",
    "deps:ci": "npm ci --verbose --no-fund --no-audit",
    "deps:update": "npm-check-updates -u && npm run deps:install"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260120.0",
    "@mantine/core": "^8.3.13",
    "@mantine/hooks": "^8.3.13",
    "@tabler/icons-react": "^3.36.1",
    "@types/moment-precise-range-plugin": "^1.3.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-moment": "^1.0.1",
    "moment": "^2.30.1",
    "moment-precise-range-plugin": "^1.3.0",
    "next": "^15.5.12",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.16.5",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.4",
    "npm-check-updates": "^19.3.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.8.3",
    "typescript": "^5",
    "wrangler": "^4.66.0"
  }
}
