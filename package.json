{
  "name": "uptimeflare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "vercel-build": "next build",
    "build": "next build",
    "start:dev": "next dev",
    "start:preview": "NODE_ENV=development @cloudflare/next-on-pages && wrangler pages dev .vercel/output/static --compatibility-flag nodejs_compat nodejs_compat_populate_process_env --kv UPTIMEFLARE_STATE",
    "deploy:cf": "npx @cloudflare/next-on-pages && wrangler pages deploy .vercel/output/static --project-name uptimeflare",
    "build:pkg": "next build",
    "start:prod": "next start",
    "fmt:lint": "next lint",
    "deps:install": "npm install --verbose --no-fund --no-audit",
    "deps:ci": "npm ci --verbose --no-fund --no-audit",
    "deps:update": "npm-check-updates -u && npm run deps:install"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20260120.0",
    "@mantine/core": "^8.3.13",
    "@mantine/ds": "^7.1.3",
    "@mantine/hooks": "^8.3.13",
    "@tabler/icons-react": "^3.36.1",
    "@types/moment-precise-range-plugin": "^1.3.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-moment": "^1.0.1",
    "moment": "^2.30.1",
    "moment-precise-range-plugin": "^1.3.0",
    "next": "^16.1.4",
    "react": "^19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.4",
    "npm-check-updates": "^19.3.1",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.8.1",
    "typescript": "^5",
    "wrangler": "^4.59.3"
  }
}
